# =============================================================================
# SmartKnob Web API Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=4000
PROTOCOL=http
DOMAIN=localhost
CORES=4
MODEL=API

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=wms
DB_PASS=wms
DB_NAME=wms
DB_CONNECTIONS=50

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Cache
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=1

# Redis Client Cache
REDIS_CLIENT_CACHE_HOST=localhost
REDIS_CLIENT_CACHE_PORT=6379
REDIS_CLIENT_CACHE_DB=1

# Redis Broker (for Sagas)
REDIS_BROKER_HOST=localhost
REDIS_BROKER_PORT=6379
REDIS_BROKER_DB=0

# Redis Pub/Sub
REDIS_PUBSUB_HOST=localhost
REDIS_PUBSUB_PORT=6379
REDIS_PUBSUB_DB=3

# Redis Queue
REDIS_QUEUE_HOST=[::]
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_DB=2

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_KEY=your-super-secret-jwt-key-change-this-in-production

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# S3 Buckets
AWS_S3_IMAGES_BUCKET=images
AWS_S3_ARCHIVES_BUCKET=archives
AWS_S3_PDFS_BUCKET=pdfs
AWS_SAWS_S3_EXCEL_BUCKET3_PDFS_BUCKET=excels

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Test emails (comma-separated list for development)
TEST_EMAILS=test@example.com,admin@example.com

# =============================================================================
# APPLICATION URLS
# =============================================================================
ADMIN_BASE_URL=http://localhost:3000
IMAGES_BASE_URL=http://localhost:4000/images

# =============================================================================
# QUERY LIMITS
# =============================================================================
DEFAULT_QUERY_LIMIT=100

# =============================================================================
# QUEUE CONFIGURATION
# =============================================================================
QUEUE_CORES=4

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
AUTH_DISABLED=false
HAS_LOADED_ENV=true

# =============================================================================
# NOTES
# =============================================================================
# 1. Change JWT_KEY to a secure random string in production
# 2. Update AWS credentials with your actual AWS account details
# 3. Configure PostgreSQL database with appropriate credentials
# 4. Set up Redis instances for different purposes (cache, queues, pub/sub)
# 5. Update ADMIN_BASE_URL to point to your frontend application
# 6. Set NODE_ENV=production for production deployments
# 7. Consider using environment-specific Redis databases for isolation
